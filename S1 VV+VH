Map.addLayer(table,{},'aoi')
Map.centerObject(table)

// 1️⃣ Display AOI
Map.addLayer(table, {}, 'AOI');
Map.centerObject(table, 8);

// 2️⃣ Sentinel-1 Image Collection
var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
  .filterBounds(table)
  .filterDate('2023-06-01', '2023-07-30')
  .filter(ee.Filter.eq('instrumentMode', 'IW'))
  .filter(ee.Filter.eq('resolution_meters', 10))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
  .select(['VV', 'VH'])
  .mean()
  .clip(table);

// 3️⃣ Separate VV and VH
var vv = s1.select('VV');
var vh = s1.select('VH');

// 4️⃣ Visualization
Map.addLayer(
  vv,
  {min: -25, max: 0},
  'Sentinel-1 VV'
);

Map.addLayer(
  vh,
  {min: -30, max: -5},
  'Sentinel-1 VH'
);

Export.image.toDrive({
  image: vv,
  description: 'Sentinel1_VV_2023',
  folder: 'GEE_Output',
  fileNamePrefix: 'S1_VV_2023',
  region: table,
  scale: 10,
  crs: 'EPSG:4326',
  maxPixels: 1e13
});


Export.image.toDrive({
  image: vh,
  description: 'Sentinel1_VH_2023',
  folder: 'GEE_Output',
  fileNamePrefix: 'S1_VH_2023',
  region: table,
  scale: 10,
  crs: 'EPSG:4326',
  maxPixels: 1e13
});

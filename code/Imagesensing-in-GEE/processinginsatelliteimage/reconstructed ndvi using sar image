/***************************************
 * 1. AOI
 ***************************************/
var aoi = table; // your imported AOI
Map.centerObject(aoi, 10);
Map.addLayer(aoi, {}, 'AOI');

/***************************************
 * 2. SENTINEL-2 (cloud-masked NDVI for training)
 ***************************************/
var s2 = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(aoi)
  .filterDate('2023-06-01','2023-07-31')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 80));

function maskS2clouds(image) {
  var qa = image.select('QA60');
  var cloud = qa.bitwiseAnd(1 << 10).eq(0);
  var cirrus = qa.bitwiseAnd(1 << 11).eq(0);
  var scl = image.select('SCL');
  var sclMask = scl.neq(3).and(scl.neq(7)).and(scl.neq(8))
                .and(scl.neq(9)).and(scl.neq(10)).and(scl.neq(11));
  return image.updateMask(cloud.and(cirrus).and(sclMask));
}

var s2_clean = s2.map(maskS2clouds);
var s2_median = s2_clean.median().clip(aoi);

// Cloud-masked NDVI
var ndvi_clean = s2_median.normalizedDifference(['B8','B4']).rename('NDVI_clean');
Map.addLayer(ndvi_clean, {min:-1, max:1, palette:['black','gray','white']}, 'Cloud-masked NDVI');

/***************************************
 * 3. SENTINEL-1 (SAR)
 ***************************************/
var s1 = ee.ImageCollection("COPERNICUS/S1_GRD")
  .filterBounds(aoi)
  .filterDate('2023-06-01','2023-07-31')
  .filter(ee.Filter.eq('instrumentMode','IW'))
  .filter(ee.Filter.eq('orbitProperties_pass','DESCENDING'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation','VV'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation','VH'));

var vv = s1.select('VV').median().clip(aoi);
var vh = s1.select('VH').median().clip(aoi);

Map.addLayer(vv, {min:-20,max:0}, 'VV');
Map.addLayer(vh, {min:-25,max:-5}, 'VH');

/***************************************
 * 4. MLR TRAINING WITH CONSTANT BAND (INTERCEPT)
 ***************************************/

// Mask NDVI pixels for training
var ndvi_mask = ndvi_clean.mask();
var vv_masked = vv.updateMask(ndvi_mask);
var vh_masked = vh.updateMask(ndvi_mask);
var sar_masked = vv_masked.addBands(vh_masked);

// Add constant band for intercept
var sar_masked_const = sar_masked.addBands(ee.Image(1).rename('const'));

// Sample training points
var training = sar_masked_const.addBands(ndvi_clean).sample({
  region: aoi,
  scale: 10,
  numPixels: 10000,
  geometries: false,
  tileScale: 4
});
print('Training sample size:', training.size());

// Multiple Linear Regression: VV + VH + const -> NDVI
var regression = training.reduceColumns({
  reducer: ee.Reducer.linearRegression({numX:3,numY:1}),
  selectors: ['VV','VH','const','NDVI_clean']
});
var coeffs = ee.Array(regression.get('coefficients')); // 3x1 array: VV, VH, intercept
print('MLR coefficients including intercept:', coeffs);

/***************************************
 * 5. APPLY MLR TO FULL SAR STACK
 ***************************************/

// Add constant band to full SAR stack
var sar_stack = vv.addBands(vh).addBands(ee.Image(1).rename('const'));

var ndvi_reconstructed = sar_stack.expression(
  'VV*a + VH*b + const*c', {
    VV: vv,
    VH: vh,
    const: ee.Image(1),
    a: coeffs.get([0,0]),
    b: coeffs.get([1,0]),
    c: coeffs.get([2,0])
}).rename('NDVI_reconstructed');

// Keep only valid cloud-free pixels
ndvi_reconstructed = ndvi_reconstructed.updateMask(ndvi_clean.mask());

// Display reconstructed NDVI
Map.addLayer(ndvi_reconstructed,
  {min:-0.2,max:0.8,palette:['black','gray','white']},
  'SAR NDVI (MLR with intercept)');

/***************************************
 * 6. EXPORT TO DRIVE
 ***************************************/
Export.image.toDrive({
  image: ndvi_reconstructed,
  description: 'SAR_NDVI_Grayscale_JuneJuly',  // <-- fixed name
  folder: 'GEE_Exports',
  region: aoi,
  scale: 10,
  maxPixels: 1e13
});
